__pycache__/
*.pyc
.DS_Store

# The fetched corpus. 27 MB over 14 partitions and rebuildable in about 40 seconds with
# scripts/pull_source.py. data/manifest.json is committed and carries a row count and a
# sha256 for every partition, so a copy that does not match the published numbers is
# something you can find out rather than something you have to trust.
data/raw/

# The split of a judged partition. Rebuildable from the raw partition and the contract in
# a couple of seconds, and the accepted file is a near copy of the input.
data/quarantine/

# The raw layer. Rebuilt in a few seconds from the accepted files by scripts/load_raw.py,
# and a duckdb file is a binary nobody can read a diff of.
data/warehouse.duckdb

# Local Airflow and dbt installs plus the Airflow home. scripts/teardown.sh removes them.
/tmp/
airflow.db
airflow.cfg
logs/
